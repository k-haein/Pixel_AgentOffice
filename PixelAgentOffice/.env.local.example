# Playwright E2E 테스트용 환경변수
# 이 파일을 .env.local 로 복사한 뒤 키를 채워 넣으세요.
# .env.local 은 gitignore되어 절대 커밋되지 않습니다.

# Google AI Studio에서 발급 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...

# (선택) Anthropic 콘솔에서 발급 (https://console.anthropic.com)
# 없으면 Anthropic 관련 테스트는 자동 skip
ANTHROPIC_API_KEY=
